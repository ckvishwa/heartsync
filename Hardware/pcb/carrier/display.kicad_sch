			)
			(justify left bottom)
		)
		(uuid "01b79089-d265-5e6e-b762-68bbaec4fc89")
	)
	(text "(G) panel: BUSY is ACTIVE LOW (low = busy, manual note 5-4), operating temperature 0..40 C. Pins 1/4/6/7 NC, each left separate."
