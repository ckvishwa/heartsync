	(text "3.12in SSD1322 panel (J11) + 12 V boost, back e-paper (J13) with booster - Ansonia carrier board rev A (rev G shell)"
		(exclude_from_sim no)
		(at 25.4 18 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "235f150e-9928-53cc-a390-cf7beb16a7bc")
	)
	(text "SSD1322 values from the SSD1322 datasheet rev 1.2 fig. 14-1: C1-C3 1 uF (VCI, VDDIO, VDD), VCOMH 4.7 uF + 0.1 uF,"
		(exclude_from_sim no)
		(at 25.4 21.2 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "378a5544-ff27-53b9-9165-1ff4480f7935")
	)
	(text "VCC 4.7 uF, VSL 50 ohm (51R used) + 2 x 1N4148 to VSS, IREF R = (VCC - 6 V)/10 uA = 600k at 12 V -> 620k (sec. 8.6)."
		(exclude_from_sim no)
		(at 25.4 23.6 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "7544d15f-3c71-562d-a46c-25bfe92cbe7b")
	)
	(text "4-wire SPI: BS0 = BS1 = 0, E/RD# and R/W# to VSS, D2 open, D3-D7 to VSS (pin table 7-1). VCC floats when off (8.9)."
		(exclude_from_sim no)
		(at 25.4 26 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "dff16dc2-99fa-53e8-8156-bd44db403856")
	)
	(text "TPS61040: Vout = 1.233 V x (1 + 487k/56k) = 11.96 V; 10 uH, Schottky, 4.7 uF in, 1 uF out (TPS61040 datasheet)."
		(exclude_from_sim no)
		(at 25.4 28.4 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "52f5c1a8-e487-59eb-9687-559a81125581")
	)
	(text "Q1/Q2 high-side switch removes the boost input so VCC floats when the panel is off (SSD1322 8.9 note 2)."
		(exclude_from_sim no)
		(at 25.4 30.8 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "1b17985e-5366-51e4-9273-f21c4f4877eb")
	)
	(text "J13 e-paper (FITTED): Waveshare 3.97in e-Paper (G) raw panel, SSD2677, 24-pin 0.5 mm FPC. Pinout (G) panel manual v1.0 sec. 5; booster (R1 2.2R, R2 1M,"
		(exclude_from_sim no)
		(at 25.4 33.2 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "867f1621-9008-5001-a972-004bb29427c9")
	)
	(text "Q1 AO3400A, L1 10uH, D1-D3 MBR0530, C1-C10 4.7/1 uF) = Waveshare 3.97inch e-Paper HAT+ (G) driver-board schematic; C1 4.7 uF on pin 5 VSH2 confirmed there."
		(exclude_from_sim no)
		(at 25.4 35.6 0)
		(effects
