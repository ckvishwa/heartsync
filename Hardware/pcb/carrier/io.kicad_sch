	(text "Three TCA9554 (0x20 outputs, 0x21 inputs, 0x22 Bluetooth control): the pin plan needs 20 I/O, one TCA9554 has 8."
		(exclude_from_sim no)
		(at 25.4 21.2 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "726a8b31-b797-5145-a688-28bbf068cf51")
	)
	(text "Outputs that must stay off at power-up get 10k pull-downs (TCA9554 inputs have 100k internal pull-ups)."
		(exclude_from_sim no)
		(at 25.4 23.6 0)
		(effects
