			)
			(justify left bottom)
		)
		(uuid "4121881c-1f8c-5baf-aacf-c2e367e1c468")
	)
	(text "DRV2605L: REG 1 uF, VDD 1 uF + 0.1 uF, IN/TRIG to GND when unused (DRV2605L datasheet pin table)."
