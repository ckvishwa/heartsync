				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "a904406d-1c14-537c-b510-8390997b1808")
	)
	(text "U12 LSM6DSOX: CS = VDDIO (I2C), SA0 = GND -> 0x6A. INT1 -> ESP32 IO3 (RTC wake, 100k pull-down), INT2 -> TCA9554 0x21 P7."
