		(at 25.4 23.6 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "1d3fbd0a-8098-5e44-a5ae-540e4fcf0ce8")
	)
	(text "N16R8 is rated -40..65 C ambient (module datasheet table 1-2): keep it away from the amp/boost heat."
