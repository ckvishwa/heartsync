	(text "N16R8 = octal PSRAM: IO35-37 not usable (module datasheet table 3-1 note b). IO0/45/46 straps unused; IO3 (JTAG-source strap, RTC wake) = IMU INT1, idle low."
		(exclude_from_sim no)
		(at 25.4 21.2 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "e140163a-3fa2-58e6-83eb-d1ee42a2a19e")
	)
	(text "IO19/20 native USB -> J1 -> power board USB-C port 1 data. EN RC 10k/1uF per module datasheet fig. 9-1."
