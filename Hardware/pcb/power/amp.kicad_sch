	(text "TAS5805M stereo BTL amplifier - Ansonia power board rev A (rev G shell)"
		(exclude_from_sim no)
		(at 25.4 18 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "077ac439-ace6-5c9d-a6a9-d36cd66c959c")
	)
	(text "PVDD = 9 V. Power limit 4 W per channel (Dayton CE70-30P-8 = 4 W max, 8 ohm -> 5.66 Vrms = 8 Vpk): set the TAS5805M"
		(exclude_from_sim no)
		(at 25.4 21.2 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "b12c296f-74c7-5622-8c86-ef383a111381")
	)
	(text "AGL / digital volume ceiling so the output never exceeds 5.66 Vrms; firmware must load that limit before unmuting."
		(exclude_from_sim no)
		(at 25.4 23.6 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "eba56dbd-e62b-5e03-8d96-5ebca0e2004a")
	)
	(text "TAS5805M datasheet fig. 8-1 / table 8-3 (ferrite-bead output filter): PVDD 2 x (22 uF + 22 uF + 0.1 uF), L5 100R@100MHz bead,"
		(exclude_from_sim no)
		(at 25.4 26 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "48b5fe7f-ce41-5233-aa2e-b9a9b442bcaf")
	)
	(text "DVDD 4.7 uF + 0.1 uF, AVDD 1 uF, VR_DIG 1 uF, BST 0.22 uF x4, outputs 300R@100MHz beads + 2200 pF + (2200 pF + 68R) per leg."
		(exclude_from_sim no)
		(at 25.4 28.4 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "f505ec29-b91a-5832-bb1c-b92b0ba4df9b")
	)
	(text "ADR 4.7k to DVDD -> I2C 0x2C. PDN from the expander with a 10k pull-down; start-up: PDN high, wait >= 5 ms, then clocks."
		(exclude_from_sim no)
		(at 25.4 30.8 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "05c510be-9588-54d3-a9ea-7949980b9fca")
	)
	(text "Channel A -> speaker L (via J1 -> carrier J4), channel B -> speaker R (J7 here). Use Fsw 384 kHz + spread spectrum (8.2.1)."
		(exclude_from_sim no)
		(at 25.4 33.2 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
