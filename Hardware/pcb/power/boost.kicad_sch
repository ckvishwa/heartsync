	(text "TPS61088 PVDD boost for the amp, 9 V - Ansonia power board rev A (rev G shell)"
		(exclude_from_sim no)
		(at 25.4 18 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "24bb6cd6-b41d-5afd-bd6e-44bf57259548")
	)
	(text "Amp boost. Values from TPS61088(-Q1) datasheet sec. 9.2: Vout = 1.204 x (1 + 499k/76.8k) = 9.03 V; RFREQ = 4(1/fsw - tdelay*Vout/Vin)/CFREQ"
		(exclude_from_sim no)
		(at 25.4 21.2 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "fcf229f0-4a87-5c00-be78-fffa1a9d90a2")
	)
	(text "-> 232k for ~600 kHz at Vin 3.2 V; L 2.2 uH (Isat > 11 A); ILIM 49.9k (FPWM peak limit 7.2 min / 8.7 typ / 10.5 max A, MODE = GND);"
		(exclude_from_sim no)
		(at 25.4 23.6 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "93d757ec-3fdd-5e27-a6fa-5756a878f653")
	)
	(text "comp R5 = 2pi Vout Rsense fc Co / ((1-D) Vref Gea) = 23.7k at fc 5 kHz, Co 45 uF eff, D 0.75; C5 = Ro Co/(2 R5) = 8.2 nF; C8 open."
		(exclude_from_sim no)
		(at 25.4 26 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "ec9fd78d-6a55-593b-baba-d90d8f7d6b55")
	)
	(text "SS 47 nF, BOOT 0.1 uF, VCC 4.7 uF. EN from the carrier expander (10k pull-down: off at power-up). Amp only: 2 x 4 W / 0.85 = 9.4 W -> 3.2 A at 3.3 V."
		(exclude_from_sim no)
		(at 25.4 28.4 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "12df1ee8-a5b6-5aef-bb3f-abb68a86be6f")
	)
	(embedded_fonts no)
)
