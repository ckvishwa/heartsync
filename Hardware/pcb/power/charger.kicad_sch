	(text "Power-bank / PD IC (placeholder), cell, NTC, protection - Ansonia power board rev A (rev G shell)"
		(exclude_from_sim no)
		(at 25.4 18 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "8b1f2d85-d4aa-589c-b1c4-f88a2c3783c0")
	)
	(text "U1 DNP placeholder: VBUS1/2, CC x2, DP2/DM2, BAT, SYS, NTC, SDA/SCL, INT, KEY. Qi TX is a separate module on J6 (IP5568 evaluated and rejected, README)."
		(exclude_from_sim no)
		(at 25.4 21.2 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "b2dbec32-ae9e-57ea-9b02-0b703fe1019a")
	)
	(text "Cell 1160100 10,000 mAh: MAIN PATH = BAT+/BAT- solder pads TP1/TP2 (4 x 4 mm, 18 AWG silicone leads). J4 (PH2.0, 2 A) carries"
		(exclude_from_sim no)
		(at 25.4 23.6 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "586e9406-05fc-5b65-a33e-52529e7bfd31")
	)
	(text "ONLY the pack NTC + return (pin 1 = pack BAT+ left open: insulate that wire). Q = reverse-battery PFET (DMP3013SFV),"
		(exclude_from_sim no)
		(at 25.4 26 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "219a6cb6-4511-5d9e-8f56-a79d0ba64e4c")
	)
	(text "F1 = 8 A fuse, D = SMF5.0A TVS. The 0R (DNP) bridges BAT_SW -> VSYS for bring-up without the PD IC."
		(exclude_from_sim no)
		(at 25.4 28.4 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "0914d9c5-f026-5577-809d-0c7ca433e6d0")
	)
	(text "Qi TX module (24 x 32 mm, own driver + coil) on J6: 9 V from PVDD through Q (AO3401A) switched by QI_EN (carrier expander"
		(exclude_from_sim no)
		(at 25.4 30.8 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "74f5e2a4-d9bd-55f3-afa1-90cdf77b103d")
	)
	(text "0x22 P6 via J1, 10k pull-down here so it is off while the expander pin floats). PVDD must be running: firmware enables the boost first."
		(exclude_from_sim no)
		(at 25.4 33.2 0)
		(effects
