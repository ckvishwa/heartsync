	(text "IP5356M power-bank IC, battery, NTC, protection - Ansonia power board rev A (rev G shell)"
		(exclude_from_sim no)
		(at 25.4 18 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "8b1f2d85-d4aa-589c-b1c4-f88a2c3783c0")
	)
	(text "U1 Injoinic IP5356M (QFN-40, datasheet V1.00): 1S charger/boost, PD3.0 on the Type-C pins (CC1/CC2, DPC/DMC, VBUS), I2C only in the _L"
		(exclude_from_sim no)
		(at 25.4 21.2 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "b2dbec32-ae9e-57ea-9b02-0b703fe1019a")
	)
	(text "(LED) models: IP5356M_LBZ_CB (LCSC C46550232). I2C = LED2 (SDA) / LED1 (SCL) with 3.3k to its VCC, INT = LED3 with 510k to GND (fig. 20)."
		(exclude_from_sim no)
		(at 25.4 23.6 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "586e9406-05fc-5b65-a33e-52529e7bfd31")
	)
	(text "Port 2 = VOUT2 (a USB-A style 5 V output, 2.2 uF) wired to Type-C J3 with Rp 22k from VBUS2 on CC1/CC2 (1.5 A). The datasheet lists"
		(exclude_from_sim no)
		(at 25.4 26 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "219a6cb6-4511-5d9e-8f56-a79d0ba64e4c")
	)
	(text "'1 Type-C in/out + 1 Type-C out (customize)' without a part number: ask Injoinic. Unused: VOUT1/DPA1/DMA1, VIN/DPB/DMB (Micro-B), CL (lightning), LED4/LED6."
		(exclude_from_sim no)
		(at 25.4 28.4 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "0914d9c5-f026-5577-809d-0c7ca433e6d0")
	)
	(text "IMPORTANT: VSYS on this IC is the internal DC-DC bus (5-12 V), NOT a system rail. The system (VSYS net) is the battery behind Q (0R link)."
		(exclude_from_sim no)
		(at 25.4 30.8 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "74f5e2a4-d9bd-55f3-afa1-90cdf77b103d")
	)
	(text "L1 2.2 uH between LX and BAT (fig. 25), BST 0.1 uF to LX, VCC 2.2 uF, NTC 100 nF at the pin, FCAP 22.1k = 10 Ah (R x 0.448 mAh)."
		(exclude_from_sim no)
		(at 25.4 33.2 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "df7d731b-7946-5709-8efd-bb2108109e57")
	)
	(text "Battery: J4 Amass MR30PW-M (BAT+ pin 1, BAT- pin 3), TP1/TP2 4x4 pads = DNP alternative for 18 AWG leads, J5 (JST SH 2) = pack NTC (10k)."
		(exclude_from_sim no)
		(at 25.4 35.6 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "50c8e664-9fea-5cbb-951f-e1f8c6c69a36")
	)
	(text "Design current: 5 A continuous / 8 A peak from the cell (pack PCM limit unknown). F1 8 A, Q = reverse-battery PFET (DMP3013SFV), D = SMF5.0A TVS."
		(exclude_from_sim no)
		(at 25.4 38 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "88420dda-85f3-5fe7-b8e2-9b19fd4b7611")
	)
	(embedded_fonts no)
)
