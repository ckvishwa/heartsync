{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 19099
    },
    "firestore": {
      "port": 18080,
      "websocketPort": 19150
    },
    "functions": {
      "port": 15001
    },
    "storage": {
      "port": 19199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true,
    "hub": {
      "port": 14400
    },
    "logging": {
      "port": 14500
    },
    "eventarc": {
      "port": 19299
    },
    "tasks": {
      "port": 19499
    }
  }
}
