rules_version = '2';

// heartsync Firestore rules. Data model: docs/protocol.md. Tests: cloud/test/.
// Deny by default: any path not matched below is denied.
// Cloud Functions and CI use the Admin SDK, which bypasses these rules.
// DEVICE TOKENS: rules are OR-ed across overlapping matches. Every new allow must
// be gated by isPerson() or be explicitly device-scoped (isDeviceOf + path checks),
// or it silently opens that path to board tokens. Add a device deny test for it.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A board's token: a custom token minted by registerDevice for the board's own
    // uid "dev_<deviceId>", with the claims deviceId, coupleId and owner (the
    // person who set it up). It acts for its owner but is scoped to its couple's
    // events and its own device record. Nothing else. Any token with a deviceId
    // claim is in board mode; it gets access only if every claim is well formed.
    function isDevice() {
      return signedIn() && 'deviceId' in request.auth.token;
    }

    function isPerson() {
      return signedIn() && !isDevice();
    }

    // A well-formed board token: own uid and an owner claim.
    function isBoard() {
      return isDevice()
        && request.auth.token.deviceId is string
        && request.auth.token.get('owner', null) is string
        && request.auth.uid == 'dev_' + request.auth.token.deviceId;
    }

    // Board token allowed in this couple (claim must match the path).
    function isDeviceOf(coupleId) {
      return isBoard() && request.auth.token.get('coupleId', null) == coupleId;
    }

    function isSelf(uid) {
      return isPerson() && request.auth.uid == uid;
    }

    // The caller is `uid`: a person signed in as uid, or a board owned by uid.
    function actsAs(uid) {
      return (isPerson() && request.auth.uid == uid)
        || (isBoard() && request.auth.token.owner == uid);
    }

    // The caller belongs to the couple: a person member, or a board whose owner
    // is a member.
    function isMember(coupleId) {
      let members = get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
      return (isPerson() && request.auth.uid in members)
        || (isBoard() && request.auth.token.owner in members);
    }

    // True if the signed-in user is the other member of `uid`'s couple.
    // `coupleId` on a user document is server-set, so it can be trusted.
    function isPartnerOf(uid) {
      let coupleId = get(/databases/$(database)/documents/users/$(uid)).data.get('coupleId', null);
      return isPerson()
        && request.auth.uid != uid
        && coupleId != null
        && isMember(coupleId);
    }

    // ---- users/{uid}: profile, avatar spec, notification token ----
    match /users/{uid} {
      allow get: if isSelf(uid) || isPartnerOf(uid);
      allow list: if false;
      // coupleId is server-set only: a client can neither set nor change it.
      allow create: if isSelf(uid) && !('coupleId' in request.resource.data);
      allow update: if isSelf(uid)
        && request.resource.data.get('coupleId', null) == resource.data.get('coupleId', null);
      allow delete: if false;

      // ---- users/{uid}/private/cycle: HEALTH DATA ----
      // Owner-only write. Partner can read only while sharingEnabled is true.
      match /private/cycle {
        allow get: if isSelf(uid)
          || (isPartnerOf(uid) && resource.data.sharingEnabled == true);
        allow list: if isSelf(uid);
        allow create, update: if isSelf(uid) && request.resource.data.sharingEnabled is bool;
        allow delete: if isSelf(uid);
      }

      // Any other private document: owner only. (Rules are OR-ed across
      // matches, so `cycle` is excluded here to keep its validation.)
      match /private/{docId} {
        allow read, write: if isSelf(uid) && docId != 'cycle';
      }
    }

    // ---- couples/{coupleId}: created by Cloud Functions or the seed script ----
    // Device tokens are denied everywhere under users/ because isSelf() and
    // isPartnerOf() both require a person's token (isPerson()).
    match /couples/{coupleId} {
      allow read: if isPerson() && request.auth.uid in resource.data.members;
      allow write: if false;

      // ---- devices: a board writes as its owner (token.owner) ----
      match /devices/{deviceId} {
        // A person may act on any device record of the couple (as owner for
        // writes). A device token only on its own record.
        function mayActOnDevice() {
          return isMember(coupleId)
            && (isPerson()
                || (isDeviceOf(coupleId) && request.auth.token.deviceId == deviceId));
        }
        allow read: if mayActOnDevice();
        // Create: only the board itself (registerDevice creates records for
        // people). A person creating records could squat on the partner's board.
        allow create: if isDeviceOf(coupleId)
          && request.auth.token.deviceId == deviceId
          && isMember(coupleId)
          && actsAs(request.resource.data.owner)
          && request.resource.data.keys().hasOnly(
               ['owner', 'firmwareVersion', 'lastSeen', 'battery', 'online']);
        allow update: if mayActOnDevice()
          && actsAs(resource.data.owner)
          && actsAs(request.resource.data.owner)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['firmwareVersion', 'lastSeen', 'battery', 'online']);
        allow delete: if false;
      }

      // ---- events: immutable, and only ever written as yourself ----
      match /events/{eventId} {
        function mayUseEvents() {
          return isMember(coupleId) && (isPerson() || isDeviceOf(coupleId));
        }
        allow read: if mayUseEvents();
        allow create: if mayUseEvents()
          && request.resource.data.keys().hasOnly(['type', 'from', 'payload', 'createdAt'])
          && request.resource.data.keys().hasAll(['type', 'from', 'payload', 'createdAt'])
          && actsAs(request.resource.data.from)
          && request.resource.data.type in ['heart', 'touch', 'art', 'mood', 'voice']
          && request.resource.data.payload is map
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // ---- releases/{version}: firmware release records, written by CI only ----
    // Device tokens are denied for now; OTA (Phase 2b) must add an explicit,
    // tested exception if boards read release records directly.
    match /releases/{version} {
      allow read: if isPerson();
      allow write: if false;
    }
  }
}
