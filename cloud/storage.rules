rules_version = '2';

// heartsync Storage rules. Objects are scoped by couple. Deny by default.
service firebase.storage {
  match /b/{bucket}/o {

    // Board tokens (deviceId claim) get no Storage access at all. OTA (Phase 2b)
    // must add an explicit, tested exception for firmware/ if boards download
    // from Storage directly.
    function isPerson() {
      return request.auth != null && !('deviceId' in request.auth.token);
    }

    function isMember(coupleId) {
      return isPerson()
        && request.auth.uid in
           firestore.get(/databases/(default)/documents/couples/$(coupleId)).data.members;
    }

    // Art, voice clips, avatars: couples/{coupleId}/...
    match /couples/{coupleId}/{allPaths=**} {
      allow read: if isMember(coupleId);
      // request.resource is null on delete.
      allow write: if isMember(coupleId)
        && (request.resource == null || request.resource.size < 5 * 1024 * 1024);
    }

    // Signed firmware binaries: uploaded by CI (Admin SDK) only.
    match /firmware/{allPaths=**} {
      allow read: if isPerson();
      allow write: if false;
    }
  }
}
