# Copy to .env.local (git-ignored) when the real Firebase project exists.
# With no .env.local the dashboard uses the local emulators and the
# demo-heartsync project, which is all Phases 1 and 2 need.
#
# This file is named env.example (no leading dot) because agents are denied
# access to .env* files.
#
# These values are public web config, not secrets. Never put a service
# account or any private key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_USE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-heartsync.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-heartsync
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-heartsync.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=
